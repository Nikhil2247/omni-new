# ============================================================================
# OMNICASSION BACKEND - Environment Variables
# ============================================================================
# Copy this file to .env and update with your values
# ============================================================================

# ===========================================================================
# APPLICATION
# ===========================================================================
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# ===========================================================================
# DATABASE (PostgreSQL)
# ===========================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnicassion?schema=public"

# Read Replica (optional - for horizontal scaling)
# DATABASE_REPLICA_URL="postgresql://postgres:postgres@localhost:5433/omnicassion?schema=public"

# ===========================================================================
# AUTHENTICATION (JWT)
# ===========================================================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"

# ===========================================================================
# ENCRYPTION
# ===========================================================================
# 64-character hex string for AES-256 encryption
ENCRYPTION_KEY="your-64-character-hex-encryption-key-for-sensitive-data-storage"

# ===========================================================================
# CORS CONFIGURATION
# ===========================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ===========================================================================
# RATE LIMITING
# ===========================================================================
RATE_LIMIT_PER_MINUTE=100

# ===========================================================================
# REDIS / DRAGONFLY (Caching & Sessions)
# ===========================================================================
DRAGONFLY_HOST="localhost"
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=""
DRAGONFLY_DB=0
DRAGONFLY_WS_DB=1

# Cache Settings
CACHE_DEFAULT_TTL=3600
CACHE_KEY_PREFIX="omni:"

# WebSocket Redis Adapter (enable for multi-instance scaling)
WEBSOCKET_REDIS_ADAPTER=false

# ===========================================================================
# MEILISEARCH (Full-text Search)
# ===========================================================================
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_API_KEY="your-meilisearch-api-key"

# ===========================================================================
# MINIO / S3 (Object Storage)
# ===========================================================================
MINIO_ENDPOINT="files.omnicassion.com"
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="omnicassion"
MINIO_DEFAULT_BUCKET="omnicassion"
MINIO_PUBLIC_URL="https://files.omnicassion.com"
MINIO_AUTO_SET_PUBLIC_READ=true

# ===========================================================================
# BULL MQ (Job Queues)
# ===========================================================================
# Uses Redis configuration above

# ===========================================================================
# LOGGING
# ===========================================================================
LOG_LEVEL="debug"

# ===========================================================================
# EXTERNAL SERVICES (Optional)
# ===========================================================================
# Email Service
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""

# SMS Service
# SMS_API_KEY=""
# SMS_SENDER_ID=""

# Payment Gateway
# PAYMENT_API_KEY=""
# PAYMENT_SECRET_KEY=""

# ===========================================================================
# AI SERVICES
# ===========================================================================
# Google Gemini API Key for AI-powered chatbot
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ===========================================================================
# MONITORING & OBSERVABILITY
# ===========================================================================
# Sentry Error Tracking (get DSN from: https://sentry.io)
# SENTRY_DSN=""
# SENTRY_RELEASE="omnicassion@2.0.0"
# SENTRY_DEV_ENABLED=false

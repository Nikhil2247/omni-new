{{#> layout title="You're invited" preheader="Join your partner's celebration on Omnicassion."}}
  <p class="eyebrow">You're invited</p>
  <h1>Plan <span class="brush">{{displayName}}</span> together</h1>
  <p><strong>{{inviterName}}</strong> has invited you to join <strong>{{displayName}}</strong> on Omnicassion, so you can plan the guest list, vendors and details side by side.</p>
  {{> button url=inviteUrl label="Accept invitation"}}
  <hr class="divider">
  <p class="small muted">Button not working? Copy and paste this link into your browser:<br><a href="{{inviteUrl}}" style="word-break:break-all;">{{inviteUrl}}</a></p>
  <p class="small muted">If you weren't expecting this, you can ignore this email.</p>
{{/layout}}

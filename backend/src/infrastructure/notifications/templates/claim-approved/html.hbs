{{#> layout title="Claim approved" preheader="Congratulations - your business claim is approved."}}
  <p class="eyebrow">Claim approved</p>
  <h1>Congratulations, <span class="brush">{{businessName}}</span> is yours</h1>
  {{> greeting}}
  <p>Great news - your claim for <strong>{{businessName}}</strong> has been approved. You now have full access to manage your business profile on Omnicassion.</p>
  <div class="callout callout-success">
    <p><strong>What you can do now</strong></p>
    <ul style="margin:8px 0 0 0;">
      <li>Complete your profile with photos and a description</li>
      <li>Add your services and pricing</li>
      <li>Upload your portfolio to showcase your work</li>
      <li>Start receiving enquiries from potential clients</li>
    </ul>
  </div>
  {{> button url=dashboardUrl label="Go to your dashboard" variant="success"}}
  {{#if reviewNotes}}
  <div class="callout callout-info">
    <p class="small"><strong>Note from our team</strong></p>
    <p class="small">{{reviewNotes}}</p>
  </div>
  {{/if}}
  {{#if helpUrl}}<p class="small muted">Need help getting started? Read our <a href="{{helpUrl}}">vendor guide</a> or contact support.</p>{{/if}}
{{/layout}}

{{#> layout title="Payment receipt" preheader="Thanks - we've received your payment."}}
  <p class="eyebrow">Payment receipt</p>
  <h1>Thank you, <span class="brush">payment received</span></h1>
  {{> greeting}}
  <p>We've received your payment. Keep this email for your records.</p>

  <div class="callout callout-success center">
    <p class="muted small">Amount paid</p>
    <p><span class="amount">{{amount}}</span> <span class="currency">{{currency}}</span></p>
  </div>

  <table role="presentation" class="details" cellpadding="0" cellspacing="0">
    <tr><td class="dl">Order #</td><td class="dv">{{orderNumber}}</td></tr>
    <tr><td class="dl">Payment method</td><td class="dv">{{paymentMethod}}</td></tr>
  </table>

  {{#if items}}
  <h3>Items</h3>
  <table role="presentation" class="details" cellpadding="0" cellspacing="0">
    {{#each items}}
    <tr><td class="dl" style="width:auto;">{{description}} &times; {{quantity}}</td><td class="dv">{{price}}</td></tr>
    {{/each}}
  </table>
  {{/if}}

  {{#if receiptUrl}}{{> button url=receiptUrl label="View full receipt" variant="secondary"}}{{/if}}
  {{> signoff}}
{{/layout}}

{{#> layout title="Verify your email" preheader="Confirm your email address to finish setting up your account."}}
  <p class="eyebrow">Almost there</p>
  <h1>Verify your <span class="brush">email</span></h1>
  {{> greeting}}
  <p>Please confirm this email address to finish setting up your Omnicassion account.</p>
  {{> button url=verificationUrl label="Verify email"}}
  {{#if expiresInHours}}<p class="small muted">This link expires in about {{expiresInHours}} hours.</p>{{/if}}
  <hr class="divider">
  <p class="small muted">Button not working? Copy and paste this link into your browser:<br><a href="{{verificationUrl}}" style="word-break:break-all;">{{verificationUrl}}</a></p>
  <p class="small muted">If you didn't create an account, you can safely ignore this email.</p>
{{/layout}}

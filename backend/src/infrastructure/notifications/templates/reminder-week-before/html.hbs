{{#> layout title="Event reminder" preheader="Your event is one week away."}}
  <p class="eyebrow">One week to go</p>
  <h1><span class="brush">{{eventName}}</span> is next week</h1>
  {{> greeting}}
  <p>A week from now we celebrate. Here's a quick reminder of the details.</p>
  <table role="presentation" class="details" cellpadding="0" cellspacing="0">
    <tr><td class="dl">When</td><td class="dv">{{eventDate}}</td></tr>
    <tr><td class="dl">Where</td><td class="dv">{{eventLocation}}</td></tr>
  </table>
  {{#if eventUrl}}{{> button url=eventUrl label="View event details"}}{{/if}}
  {{> signoff}}
{{/layout}}

{{#> layout title="Verify your claim" preheader="Your verification code is inside."}}
  <p class="eyebrow">Claim your business</p>
  <h1>One step from claiming <span class="brush">{{businessName}}</span></h1>
  {{> greeting}}
  <p>Use this verification code to complete your claim:</p>
  <div class="code-box">
    <span class="code">{{verificationCode}}</span>
  </div>
  <p class="small muted">This code expires in <strong>{{expiresIn}}</strong>.</p>
  <hr class="divider">
  <p class="small muted">Once claimed, you can manage your profile, respond to enquiries, showcase your portfolio and receive booking requests.</p>
  <p class="small muted">If you didn't request this, you can safely ignore this email.</p>
{{/layout}}

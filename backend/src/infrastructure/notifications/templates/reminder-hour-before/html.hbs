{{#> layout title="Starting soon" preheader="Your event starts in about an hour."}}
  <p class="eyebrow">Starting soon</p>
  <h1><span class="brush">{{eventName}}</span> starts in about an hour</h1>
  {{> greeting}}
  <p>Time to get ready - here's where you need to be.</p>
  <table role="presentation" class="details" cellpadding="0" cellspacing="0">
    <tr><td class="dl">When</td><td class="dv">{{eventDate}}</td></tr>
    <tr><td class="dl">Where</td><td class="dv">{{eventLocation}}</td></tr>
  </table>
  {{#if eventUrl}}{{> button url=eventUrl label="View event details"}}{{/if}}
  {{> signoff}}
{{/layout}}
